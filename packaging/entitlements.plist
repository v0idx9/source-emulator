<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Entitlements for the TrollStore-installed .tipa.

	  dynamic-codesigning is the one that matters: it grants persistent JIT
	  (MAP_JIT + pthread_jit_write_protect_np W^X toggling) so box64's dynarec
	  can write and run translated arm64 code. TrollStore signs with these
	  intact; a normal App Store / sideload signature cannot carry it.

	  See ARCHITECTURE.md section 1.
	-->
	<key>dynamic-codesigning</key>
	<true/>

	<key>get-task-allow</key>
	<true/>

	<!-- Large address space for the emulated guest + translation cache. -->
	<key>com.apple.developer.kernel.increased-memory-limit</key>
	<true/>
	<key>com.apple.developer.kernel.extended-virtual-addressing</key>
	<true/>
</dict>
</plist>
